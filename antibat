local connection = nil

local spikeAmplitude   = 10000
local spikePhase       = 0
local spikeDirection   = 1

_G.VenomAntiBatEnabled      = (_G.VenomAntiBatEnabled == true)
_G._VenomAntiBatDesiredXZ   = nil
_G._VenomAntiBatSpiking      = false

local function disableSpike()
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
		connection = nil
	end

	spikeAmplitude = 10000
	spikePhase     = 0
	spikeDirection = 1
	_G._VenomAntiBatDesiredXZ = nil
	_G._VenomAntiBatSpiking   = false
end

local function enableSpike()
	disableSpike()

	connection = RunService.Heartbeat:Connect(function()
		if not _G.VenomAntiBatEnabled then
			return
		end

		local character = localPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root.Parent then
			return
		end

		local savedXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)

		spikeAmplitude = spikeAmplitude + 500 * spikeDirection

		if spikeAmplitude >= 20000 then
			spikeAmplitude = 10000
			spikeDirection = -1
		elseif spikeAmplitude <= 10000 then
			spikeAmplitude = 10000
			spikeDirection = 1
		end

		spikePhase = spikePhase + math.random() * 0.5
		local magnitude = spikeAmplitude + math.random(-5000, 5000)
		local spikeX = math.cos(spikePhase) * magnitude
		local spikeZ = math.sin(spikePhase) * magnitude

		_G._VenomAntiBatSpiking = true
		root.Velocity = Vector3.new(spikeX, root.Velocity.Y, spikeZ)

		RunService.RenderStepped:Wait()

		if root.Parent then
			local desired = _G._VenomAntiBatDesiredXZ
			if desired then
				root.Velocity = Vector3.new(desired.X, root.Velocity.Y, desired.Z)
			else
				root.Velocity = Vector3.new(savedXZ.X, root.Velocity.Y, savedXZ.Z)
			end
		end

		_G._VenomAntiBatSpiking = false
	end)
end

local function setEnabled(enabled)
	enabled = enabled and true or false
	_G.VenomAntiBatEnabled = enabled
	if enabled then
		enableSpike()
	else
		disableSpike()
	end
end

_G.VenomAntiBat = {
	setEnabled = setEnabled,
	isEnabled  = function()
		return _G.VenomAntiBatEnabled == true
	end,
	toggle = function()
		setEnabled(not (_G.VenomAntiBatEnabled == true))
	end,
}

task.spawn(function()
	while _G.VenomAntiBatStandaloneRunning do
		task.wait(0.5)
		if _G.VenomAntiBatEnabled then
			if not connection then
				pcall(enableSpike)
			end
		elseif connection then
			pcall(disableSpike)
		end
	end
end)

localPlayer.CharacterAdded:Connect(function()
	task.wait(0.1)
	if _G.VenomAntiBatEnabled then
