local function refreshToggleVisual()
	if _G.VenomAntiBatEnabled == true then
		statusLabel.Text = "ON"
		statusLabel.TextColor3 = Color3.fromRGB(160, 255, 160)
		toggleBtn.Text = "TURN OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
		toggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	else
		statusLabel.Text = "OFF"
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		toggleBtn.Text = "TURN ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
		toggleBtn.TextColor3 = Color3.fromRGB(245, 245, 245)
	end
end

